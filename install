#!/usr/bin/env bash
# Set up this environment. Safe to re-run; every step is idempotent.
set -euo pipefail

ENV_HOME="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ENV_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/env"
. "$ENV_HOME/lib/ui.sh"

ALL_COMPONENTS=(config packages links zsh node)

usage() {
  cat <<EOF
Usage: ./install [options] [component...]

Components (default: all, in this order):
  config     Create $ENV_CONFIG_DIR/config.sh from config.example.sh
  packages   Install apps from packages/apps.txt (apt, cargo) + \$ENV_APT_EXTRA
  links      Hook shell/tmux/vim configs into ~/.bashrc, ~/.zshrc, ~/.tmux.conf,
             ~/.vimrc (and nvim, if it has no config of its own)
  zsh        Install powerlevel10k unless ~/.zshrc already loads it
  node       Install nvm + node, then npm packages/npm.txt + \$ENV_NPM_EXTRA

Options:
  -n, --dry-run   Print what would be done without changing anything
  -u, --upgrade   Also apt upgrade/autoremove and update cargo apps
  -h, --help      Show this help
EOF
}

DRY_RUN=0
UPGRADE=0
COMPONENTS=()
while [ $# -gt 0 ]; do
  case $1 in
    -n|--dry-run) DRY_RUN=1 ;;
    -u|--upgrade) UPGRADE=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; die "Unknown option: $1" ;;
    *)
      [[ " ${ALL_COMPONENTS[*]} " == *" $1 "* ]] || die "Unknown component: $1"
      COMPONENTS+=("$1") ;;
  esac
  shift
done
[ ${#COMPONENTS[@]} -gt 0 ] || COMPONENTS=("${ALL_COMPONENTS[@]}")

# --- Settings (defaults, then user config) ------------------------------------
ENV_APT_EXTRA=""
ENV_NPM_EXTRA=""
ENV_NODE_VERSION="node"
ENV_P10K_DIR="$HOME/powerlevel10k"
if [ -r "$ENV_CONFIG_DIR/config.sh" ]; then
  set +u; . "$ENV_CONFIG_DIR/config.sh"; set -u
fi

# --- Helpers ------------------------------------------------------------------
run() {
  if [ "$DRY_RUN" = 1 ]; then info "[dry-run] $*"; else "$@"; fi
}

# Print non-comment words from a package list file
read_list() { sed 's/#.*//' "$1" | tr -s '[:space:]' '\n' | sed '/^$/d'; }

# Ensure LINE is in FILE. If a line equal to OLD exists (a stale path from an
# earlier layout of this repo), replace it instead of appending.
ensure_line() {
  local file=$1 line=$2 old=${3:-}
  if [ -f "$file" ] && grep -qxF -- "$line" "$file"; then
    info "ok       $file"
  elif [ -n "$old" ] && [ -f "$file" ] && grep -qxF -- "$old" "$file"; then
    info "updated  $file"
    [ "$DRY_RUN" = 1 ] && return
    local tmp; tmp=$(mktemp)
    awk -v old="$old" -v new="$line" '$0 == old { $0 = new } { print }' "$file" > "$tmp"
    cat "$tmp" > "$file" && rm -f "$tmp"   # cat keeps permissions/symlinks
  else
    info "appended $file"
    [ "$DRY_RUN" = 1 ] && return
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$line" >> "$file"
  fi
}

# --- Components ---------------------------------------------------------------
do_config() {
  local cfg="$ENV_CONFIG_DIR/config.sh"
  if [ -e "$cfg" ]; then
    info "ok       $cfg"
  else
    info "created  $cfg"
    run mkdir -p "$ENV_CONFIG_DIR"
    run cp "$ENV_HOME/config.example.sh" "$cfg"
  fi
}

do_links() {
  ensure_line "$HOME/.bashrc"    ". $ENV_HOME/shell/init.bash"      ". $ENV_HOME/.bashrc"
  ensure_line "$HOME/.tmux.conf" "source-file $ENV_HOME/tmux/tmux.conf" "source-file $ENV_HOME/.tmux.conf"
  ensure_line "$HOME/.vimrc"     "source $ENV_HOME/vim/vimrc"       "source $ENV_HOME/.vimrc"
  if command -v zsh >/dev/null || [ -f "$HOME/.zshrc" ]; then
    ensure_line "$HOME/.zshrc" "source $ENV_HOME/shell/init.zsh"
  fi
  local nvim_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
  if [ -f "$nvim_dir/init.lua" ]; then
    info "skipped  $nvim_dir (has init.lua)"
  else
    ensure_line "$nvim_dir/init.vim" "source $ENV_HOME/vim/vimrc"
  fi
}

# Parse packages/apps.txt into parallel arrays
APP_NAMES=() APP_SRC=() APP_PKGS=() APP_DESC=()
load_apps() {
  local name spec desc
  while read -r name spec desc; do
    case $name in ''|'#'*) continue ;; esac
    [[ $spec == *:?* ]] || die "packages/apps.txt: bad source '$spec' for $name"
    APP_NAMES+=("$name")
    APP_SRC+=("${spec%%:*}")
    APP_PKGS+=("${spec#*:}")
    APP_DESC+=("$desc")
  done < "$ENV_HOME/packages/apps.txt"
}

# Names of the apps to install
selected_apps() { printf '%s\n' "${APP_NAMES[@]}"; }

do_packages() {
  load_apps
  local -A want=()
  local name i pkgs apt=() cargo=()
  while read -r name; do [ -n "$name" ] && want[$name]=1; done < <(selected_apps)

  for i in "${!APP_NAMES[@]}"; do
    [ -n "${want[${APP_NAMES[i]}]:-}" ] || continue
    IFS=, read -ra pkgs <<< "${APP_PKGS[i]}"
    case ${APP_SRC[i]} in
      apt)   apt+=("${pkgs[@]}") ;;
      cargo) cargo+=("$i") ;;
      *)     warn "Unknown source '${APP_SRC[i]}' for ${APP_NAMES[i]}" ;;
    esac
  done
  # shellcheck disable=SC2206
  apt+=($ENV_APT_EXTRA)

  if ! command -v apt-get >/dev/null; then
    warn "apt-get not found; skipping apt packages"
  else
    run sudo apt-get update
    if [ "$UPGRADE" = 1 ]; then
      run sudo apt-get upgrade -y
      run sudo apt-get autoremove -y
    fi
    [ ${#apt[@]} -eq 0 ] || run sudo apt-get install -y "${apt[@]}"
  fi

  for i in "${cargo[@]}"; do
    name=${APP_NAMES[i]}
    IFS=, read -ra pkgs <<< "${APP_PKGS[i]}"
    if command -v "$name" >/dev/null && [ "$UPGRADE" = 0 ]; then
      info "ok       $name (cargo; --upgrade to update)"
    elif ! command -v cargo >/dev/null; then
      warn "Skipping $name: needs cargo (https://rustup.rs)"
    else
      run cargo install --locked "${pkgs[@]}"
    fi
  done
}

do_zsh() {
  if [ -f "$HOME/.zshrc" ] && grep -q 'powerlevel10k.zsh-theme' "$HOME/.zshrc"; then
    info "ok       powerlevel10k already loaded by ~/.zshrc"
    return
  fi
  [ -d "$ENV_P10K_DIR" ] || \
    run git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ENV_P10K_DIR"
  ensure_line "$HOME/.zshrc" "source $ENV_P10K_DIR/powerlevel10k.zsh-theme"
  info "Recommended font: https://github.com/romkatv/powerlevel10k#fonts"
  [ "${SHELL##*/}" = zsh ] || info "Make zsh your login shell with: chsh -s \"\$(command -v zsh)\""
}

do_node() {
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    local tag
    tag=$(curl -fsSL https://api.github.com/repos/nvm-sh/nvm/releases/latest |
          sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
    [ -n "$tag" ] || die "Could not determine latest nvm release"
    info "Installing nvm $tag"
    if [ "$DRY_RUN" = 1 ]; then
      info "[dry-run] curl .../nvm/$tag/install.sh | bash"
    else
      curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$tag/install.sh" | bash
    fi
  fi
  [ "$DRY_RUN" = 1 ] && [ ! -s "$NVM_DIR/nvm.sh" ] && return

  # nvm is not written for strict mode: nvm.sh can return non-zero (e.g. when
  # no default node exists yet), which would silently abort under set -e
  local rc=0
  set +euo pipefail
  . "$NVM_DIR/nvm.sh"
  run nvm install "$ENV_NODE_VERSION" || rc=$?
  set -euo pipefail
  [ "$rc" = 0 ] || die "nvm install $ENV_NODE_VERSION failed ($rc)"

  local pkgs
  # shellcheck disable=SC2206
  pkgs=($(read_list "$ENV_HOME/packages/npm.txt") $ENV_NPM_EXTRA)
  if [ ${#pkgs[@]} -gt 0 ]; then
    run npm install -g "${pkgs[@]}"
  fi
}

# --- Main ---------------------------------------------------------------------
[ "$DRY_RUN" = 1 ] && warn "Dry run: nothing will be changed"
for c in "${ALL_COMPONENTS[@]}"; do
  [[ " ${COMPONENTS[*]} " == *" $c "* ]] || continue
  section "$c"
  "do_$c"
done
section "Done"
info "Open a new shell (or run: src) to load changes"
