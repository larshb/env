#!/usr/bin/env bash
# Set up this environment. Safe to re-run; every step is idempotent.
set -euo pipefail

ENV_HOME="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
. "$ENV_HOME/lib/ui.sh"
set +u; . "$ENV_HOME/settings.sh"; set -u   # Defaults + ~/.config/env/config.sh

ALL_COMPONENTS=(config packages links zsh node)

usage() {
  cat <<EOF
Usage: ./install [options] [component...]

Components (default: all, in this order):
  config     Create $ENV_CONFIG_DIR/config.sh from config.example.sh
  packages   Install the selected apps from packages/apps.txt (apt, cargo)
             + \$ENV_APT_EXTRA. Asks which apps to install on first run
  links      Hook shell/tmux/vim configs into ~/.bashrc, ~/.zshrc, ~/.tmux.conf,
             ~/.vimrc, nvim (if it has no config of its own); set delta as
             git pager if none is set
  zsh        Install powerlevel10k unless ~/.zshrc already loads it
  node       Install nvm + node, then npm packages/npm.txt + \$ENV_NPM_EXTRA

Options:
  -n, --dry-run   Print what would be done without changing anything
  -s, --select    Choose which apps to install (alone: run only 'packages')
  -y, --yes       Never prompt; use the saved app selection (default: all)
  -u, --upgrade   Also apt upgrade/autoremove and update cargo apps
  -h, --help      Show this help
EOF
}

DRY_RUN=0
UPGRADE=0
SELECT=0
YES=0
COMPONENTS=()
while [ $# -gt 0 ]; do
  case $1 in
    -n|--dry-run) DRY_RUN=1 ;;
    -u|--upgrade) UPGRADE=1 ;;
    -s|--select) SELECT=1 ;;
    -y|--yes) YES=1 ;;
    -h|--help) usage; exit 0 ;;
    --rice)
      info "We left the rice fields in 2023 and we are not going back."
      info "No themes, no plugins. If you must: ~/.config/env/tmux.local.conf"
      exit 0 ;;
    -*) usage >&2; die "Unknown option: $1" ;;
    *)
      [[ " ${ALL_COMPONENTS[*]} " == *" $1 "* ]] || die "Unknown component: $1"
      COMPONENTS+=("$1") ;;
  esac
  shift
done
if [ ${#COMPONENTS[@]} -eq 0 ]; then
  if [ "$SELECT" = 1 ]; then COMPONENTS=(packages); else COMPONENTS=("${ALL_COMPONENTS[@]}"); fi
fi

# --- Helpers ------------------------------------------------------------------
run() {
  if [ "$DRY_RUN" = 1 ]; then info "[dry-run] $*"; else "$@"; fi
}

# Print non-comment words from a package list file
read_list() { sed 's/#.*//' "$1" | tr -s '[:space:]' '\n' | sed '/^$/d'; }

# Ensure LINE is in FILE. If a line equal to OLD exists (a stale path from an
# earlier layout of this repo), replace it instead of appending.
ensure_line() {
  local file=$1 line=$2 old=${3:-}
  if [ -f "$file" ] && grep -qxF -- "$line" "$file"; then
    info "ok       $file"
  elif [ -n "$old" ] && [ -f "$file" ] && grep -qxF -- "$old" "$file"; then
    info "updated  $file"
    [ "$DRY_RUN" = 1 ] && return
    local tmp; tmp=$(mktemp)
    awk -v old="$old" -v new="$line" '$0 == old { $0 = new } { print }' "$file" > "$tmp"
    cat "$tmp" > "$file" && rm -f "$tmp"   # cat keeps permissions/symlinks
  else
    info "appended $file"
    [ "$DRY_RUN" = 1 ] && return
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$line" >> "$file"
  fi
}

# --- Components ---------------------------------------------------------------
do_config() {
  local cfg="$ENV_CONFIG_DIR/config.sh"
  if [ -e "$cfg" ]; then
    info "ok       $cfg"
  else
    info "created  $cfg"
    run mkdir -p "$ENV_CONFIG_DIR"
    run cp "$ENV_HOME/config.example.sh" "$cfg"
  fi
}

do_links() {
  ensure_line "$HOME/.bashrc"    ". $ENV_HOME/shell/init.bash"      ". $ENV_HOME/.bashrc"
  ensure_line "$HOME/.tmux.conf" "source-file $ENV_HOME/tmux/tmux.conf" "source-file $ENV_HOME/.tmux.conf"
  ensure_line "$HOME/.vimrc"     "source $ENV_HOME/vim/vimrc"       "source $ENV_HOME/.vimrc"
  if command -v zsh >/dev/null || [ -f "$HOME/.zshrc" ]; then
    ensure_line "$HOME/.zshrc" "source $ENV_HOME/shell/init.zsh"
  fi
  local nvim_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
  if [ -f "$nvim_dir/init.lua" ]; then
    info "skipped  $nvim_dir (has init.lua)"
  else
    ensure_line "$nvim_dir/init.vim" "source $ENV_HOME/vim/vimrc"
  fi
  # Use delta for git diffs, unless a pager is already configured
  if command -v delta >/dev/null; then
    if [ -n "$(git config --global --get core.pager || true)" ]; then
      info "ok       git pager already set ($(git config --global --get core.pager))"
    else
      info "set      git pager to delta"
      run git config --global core.pager delta
      run git config --global interactive.diffFilter "delta --color-only"
    fi
  fi
}

# Parse packages/apps.txt into parallel arrays
APP_NAMES=() APP_SRC=() APP_PKGS=() APP_DESC=()
load_apps() {
  local name spec desc
  while read -r name spec desc; do
    case $name in ''|'#'*) continue ;; esac
    [[ $spec == *:?* ]] || die "packages/apps.txt: bad source '$spec' for $name"
    APP_NAMES+=("$name")
    APP_SRC+=("${spec%%:*}")
    APP_PKGS+=("${spec#*:}")
    APP_DESC+=("$desc")
  done < "$ENV_HOME/packages/apps.txt"
}

# --- App selection ------------------------------------------------------------
# Saved in $ENV_CONFIG_DIR/apps as +name (install) / -name (skip) lines.
APPS_FILE="$ENV_CONFIG_DIR/apps"
declare -A CHECKED=()   # name -> 1/0

pick_whiptail() {
  local i args=() out name rows
  for i in "${!APP_NAMES[@]}"; do
    name=${APP_NAMES[i]}
    args+=("$name" "${APP_DESC[i]}" "$([ "${CHECKED[$name]}" = 1 ] && echo ON || echo OFF)")
  done
  rows=$(tput lines 2>/dev/null || echo 24)
  rows=$(( rows > ${#APP_NAMES[@]} + 9 ? ${#APP_NAMES[@]} + 9 : rows ))
  out=$(whiptail --title "Apps to install" --separate-output \
          --checklist "Space toggles, Enter confirms, Esc cancels" \
          "$rows" 72 $((rows - 8)) "${args[@]}" 3>&1 1>&2 2>&3) || return 1
  for name in "${APP_NAMES[@]}"; do CHECKED[$name]=0; done
  while read -r name; do [ -n "$name" ] && CHECKED[$name]=1; done <<< "$out"
}

pick_text() {
  local i n reply name
  while true; do
    echo
    for i in "${!APP_NAMES[@]}"; do
      name=${APP_NAMES[i]}
      printf '%3d [%s] %-10s %s\n' $((i + 1)) \
        "$([ "${CHECKED[$name]}" = 1 ] && echo x || echo ' ')" "$name" "${APP_DESC[i]}"
    done
    printf 'Toggle numbers (e.g. 3 7), a=all, n=none, q=cancel, Enter=done: '
    read -r reply || return 1
    case $reply in
      '') return 0 ;;
      q) return 1 ;;
      a|n) for name in "${APP_NAMES[@]}"; do CHECKED[$name]=$([ "$reply" = a ] && echo 1 || echo 0); done ;;
      *)
        for n in $reply; do
          if [[ $n =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#APP_NAMES[@]} ]; then
            name=${APP_NAMES[n - 1]}
            CHECKED[$name]=$(( 1 - CHECKED[$name] ))
          else
            warn "Not an app number: $n"
          fi
        done ;;
    esac
  done
}

# Sets SELECTED to the names of the apps to install
SELECTED=()
select_apps() {
  local line name new=()
  declare -A saved=()
  if [ -f "$APPS_FILE" ]; then
    while read -r line; do
      case $line in +?*) saved[${line#+}]=1 ;; -?*) saved[${line#-}]=0 ;; esac
    done < "$APPS_FILE"
  fi
  for name in "${APP_NAMES[@]}"; do
    if [ -n "${saved[$name]:-}" ]; then
      CHECKED[$name]=${saved[$name]}
    else
      CHECKED[$name]=1   # new apps default to on
      new+=("$name")
    fi
  done

  local ask=0
  if [ "$SELECT" = 1 ] || [ ${#new[@]} -gt 0 ]; then ask=1; fi
  if [ "$ask" = 1 ] && { [ "$YES" = 1 ] || ! [ -t 0 ] || ! [ -t 1 ]; }; then
    [ "$SELECT" = 1 ] && die "--select needs an interactive terminal"
    [ -f "$APPS_FILE" ] && warn "Not in your selection yet, installing: ${new[*]} (change with --select)"
    ask=0
  fi

  if [ "$ask" = 1 ]; then
    [ -f "$APPS_FILE" ] && [ ${#new[@]} -gt 0 ] && info "New apps since last selection: ${new[*]}"
    local picker=$ENV_PICKER
    if [ "$picker" = auto ]; then
      command -v whiptail >/dev/null && picker=whiptail || picker=text
    fi
    "pick_$picker" || die "Cancelled; nothing installed"
    if [ "$DRY_RUN" = 1 ]; then
      info "[dry-run] would save selection to $APPS_FILE"
    else
      mkdir -p "$ENV_CONFIG_DIR"
      {
        echo "# App selection for ./install (+ install, - skip). Edit or use --select."
        for name in "${APP_NAMES[@]}"; do
          printf '%s%s\n' "$([ "${CHECKED[$name]}" = 1 ] && echo + || echo -)" "$name"
        done
      } > "$APPS_FILE"
      info "Saved selection to $APPS_FILE"
    fi
  fi

  SELECTED=()
  for name in "${APP_NAMES[@]}"; do
    [ "${CHECKED[$name]}" = 1 ] && SELECTED+=("$name")
  done
  local skipped=$(( ${#APP_NAMES[@]} - ${#SELECTED[@]} ))
  info "Installing ${#SELECTED[@]} of ${#APP_NAMES[@]} apps$([ "$skipped" -gt 0 ] && echo " (change with --select)")"
}

do_packages() {
  load_apps
  select_apps
  local -A want=()
  local name i pkgs apt=() cargo=()
  for name in "${SELECTED[@]}"; do want[$name]=1; done

  for i in "${!APP_NAMES[@]}"; do
    [ -n "${want[${APP_NAMES[i]}]:-}" ] || continue
    IFS=, read -ra pkgs <<< "${APP_PKGS[i]}"
    case ${APP_SRC[i]} in
      apt)   apt+=("${pkgs[@]}") ;;
      cargo) cargo+=("$i") ;;
      *)     warn "Unknown source '${APP_SRC[i]}' for ${APP_NAMES[i]}" ;;
    esac
  done
  # shellcheck disable=SC2206
  apt+=($ENV_APT_EXTRA)

  # Cargo apps are built with rustup's stable Rust in ~/.cargo; Ubuntu's
  # cargo package is often too old for them (yazi needs a recent rustc)
  export PATH="$HOME/.cargo/bin:$PATH"
  local need_rust=0 get_rustup=0
  for i in "${cargo[@]}"; do
    if [ "$UPGRADE" = 1 ] || ! command -v "${APP_NAMES[i]}" >/dev/null; then
      need_rust=1
    fi
  done
  if [ "$need_rust" = 1 ] && ! command -v rustup >/dev/null; then
    get_rustup=1
    apt+=(curl build-essential)   # rustup installer; C linker for cargo
  fi

  if ! command -v apt-get >/dev/null; then
    warn "apt-get not found; skipping apt packages"
  else
    # --yes / no terminal: also stop package setup scripts from prompting
    # (e.g. tzdata asking for a timezone)
    local apt_get=(sudo apt-get)
    if [ "$YES" = 1 ] || ! [ -t 0 ]; then
      apt_get=(sudo env DEBIAN_FRONTEND=noninteractive apt-get)
    fi
    run "${apt_get[@]}" update
    if [ "$UPGRADE" = 1 ]; then
      run "${apt_get[@]}" upgrade -y
      run "${apt_get[@]}" autoremove -y
    fi
    # Skip packages this release doesn't have (e.g. lazygit on 24.04) rather
    # than failing the whole install
    local p avail=() missing=()
    for p in "${apt[@]}"; do
      if LC_ALL=C apt-cache policy "$p" 2>/dev/null | grep 'Candidate: [^(]' >/dev/null; then
        avail+=("$p")
      else
        missing+=("$p")
      fi
    done
    [ ${#missing[@]} -eq 0 ] || warn "Not available from apt here, skipping: ${missing[*]}"
    [ ${#avail[@]} -eq 0 ] || run "${apt_get[@]}" install -y "${avail[@]}"
  fi

  if [ "$get_rustup" = 1 ]; then
    run sh -c "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
      sh -s -- -y --no-modify-path --profile minimal"
  elif [ "$need_rust" = 1 ] && [ "$UPGRADE" = 1 ]; then
    run rustup update stable
  fi

  for i in "${cargo[@]}"; do
    name=${APP_NAMES[i]}
    IFS=, read -ra pkgs <<< "${APP_PKGS[i]}"
    if command -v "$name" >/dev/null && [ "$UPGRADE" = 0 ]; then
      info "ok       $name (cargo; --upgrade to update)"
    elif ! command -v cargo >/dev/null && [ "$DRY_RUN" = 0 ]; then
      warn "Skipping $name: cargo is not available"
    else
      run cargo install --locked --force "${pkgs[@]}"
    fi
  done
}

do_zsh() {
  if [ -f "$HOME/.zshrc" ] && grep -q 'powerlevel10k.zsh-theme' "$HOME/.zshrc"; then
    info "ok       powerlevel10k already loaded by ~/.zshrc"
    return
  fi
  [ -d "$ENV_P10K_DIR" ] || \
    run git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ENV_P10K_DIR"
  ensure_line "$HOME/.zshrc" "source $ENV_P10K_DIR/powerlevel10k.zsh-theme"
  info "Recommended font: https://github.com/romkatv/powerlevel10k#fonts"
  [ "${SHELL##*/}" = zsh ] || info "Make zsh your login shell with: chsh -s \"\$(command -v zsh)\""
}

do_node() {
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ ! -s "$NVM_DIR/nvm.sh" ]; then
    local tag
    tag=$(curl -fsSL https://api.github.com/repos/nvm-sh/nvm/releases/latest |
          sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
    [ -n "$tag" ] || die "Could not determine latest nvm release"
    info "Installing nvm $tag"
    if [ "$DRY_RUN" = 1 ]; then
      info "[dry-run] curl .../nvm/$tag/install.sh | bash"
    else
      curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/$tag/install.sh" | bash
    fi
  fi
  [ "$DRY_RUN" = 1 ] && [ ! -s "$NVM_DIR/nvm.sh" ] && return

  # nvm is not written for strict mode: nvm.sh can return non-zero (e.g. when
  # no default node exists yet), which would silently abort under set -e
  local rc=0
  set +euo pipefail
  . "$NVM_DIR/nvm.sh"
  run nvm install "$ENV_NODE_VERSION" || rc=$?
  set -euo pipefail
  [ "$rc" = 0 ] || die "nvm install $ENV_NODE_VERSION failed ($rc)"

  local pkgs
  # shellcheck disable=SC2206
  pkgs=($(read_list "$ENV_HOME/packages/npm.txt") $ENV_NPM_EXTRA)
  if [ ${#pkgs[@]} -gt 0 ]; then
    run npm install -g "${pkgs[@]}"
  fi
}

# --- Main ---------------------------------------------------------------------
[ "$DRY_RUN" = 1 ] && warn "Dry run: nothing will be changed"
for c in "${ALL_COMPONENTS[@]}"; do
  [[ " ${COMPONENTS[*]} " == *" $c "* ]] || continue
  section "$c"
  "do_$c"
done
section "Done"
info "Open a new shell (or run: src) to load changes"
